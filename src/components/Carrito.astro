---
import { Image } from 'astro:assets';
import iconoCarrito from '../assets/images/iconos/carrito.svg';
---

<li class="submenu">
  <Image src={iconoCarrito} id="img-carrito" alt="carrito" />
  <div id="carrito">
    <table id="lista-carrito">
      <thead>
        <tr>
          <th>Imagen</th>
          <th>Nombre</th>
          <th>Precio</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <a href="#" id="vaciar-carrito" class="btn-2"> Vaciar carrito</a>
  </div>
</li>

<script>
  // Carrito en memoria (igual que el original): agregar, quitar y vaciar. Sin persistencia.
  const carrito = document.getElementById('carrito');
  const productos = document.getElementById('lista-1');
  const lista = document.querySelector<HTMLTableSectionElement>('#lista-carrito tbody');

  function agregarProducto(e: Event) {
    const boton = (e.target as HTMLElement).closest<HTMLAnchorElement>('.agregar-carrito');
    if (!boton || !lista) return;
    e.preventDefault();

    const producto = boton.closest('.product');
    if (!producto) return;
    const img = producto.querySelector('img');

    const fila = document.createElement('tr');

    const celdaImg = document.createElement('td');
    const miniatura = document.createElement('img');
    // currentSrc = la versión (AVIF/WebP) que el navegador ya descargó
    miniatura.src = img?.currentSrc || img?.src || '';
    miniatura.alt = '';
    miniatura.width = 100;
    celdaImg.append(miniatura);

    const celdaTitulo = document.createElement('td');
    celdaTitulo.textContent = producto.querySelector('h3')?.textContent ?? '';

    const celdaPrecio = document.createElement('td');
    celdaPrecio.textContent = producto.querySelector('.precio')?.textContent ?? '';

    const celdaBorrar = document.createElement('td');
    const borrar = document.createElement('a');
    borrar.href = '#';
    borrar.className = 'borrar';
    borrar.dataset.id = boton.dataset.id ?? '';
    borrar.textContent = 'X';
    celdaBorrar.append(borrar);

    fila.append(celdaImg, celdaTitulo, celdaPrecio, celdaBorrar);
    lista.append(fila);
  }

  function manejarCarrito(e: Event) {
    const objetivo = e.target as HTMLElement;
    if (objetivo.closest('.borrar')) {
      e.preventDefault();
      objetivo.closest('tr')?.remove();
    } else if (objetivo.closest('#vaciar-carrito')) {
      e.preventDefault();
      lista?.replaceChildren();
    }
  }

  productos?.addEventListener('click', agregarProducto);
  carrito?.addEventListener('click', manejarCarrito);
</script>
