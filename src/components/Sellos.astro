---
import { sellos } from '../data/site';
---

<section class="sellos" aria-label="Lo que garantizamos">
  <ul class="container sellos-list" data-reveal>
    {
      sellos.map((s) => (
        <li>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {s}
        </li>
      ))
    }
  </ul>
</section>
