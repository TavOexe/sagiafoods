---
import { Picture } from 'astro:assets';
import lechuga from '../assets/images/cultivos/cultivo-lechuga.jpg';
---

<section id="inicio" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-anim" style="--d: 0">Hortalizas frescas · Lima, Perú</p>
      <h1 class="hero-title">
        <span class="line"><span style="--d: 1">Del Valle de Lurín</span></span>
        <span class="line"><span style="--d: 2">a tu mesa, <em>listo</em></span></span>
        <span class="line"><span style="--d: 3"><em>para usar.</em></span></span>
      </h1>
      <p class="hero-lead hero-anim" style="--d: 4">
        Cultivamos y seleccionamos hortalizas en nuestras chacras, y nos encargamos de la limpieza,
        el corte y el empaque. Ensaladas y hojas verdes frescas, con agua de fuente propia y libres
        de pesticidas.
      </p>
      <div class="hero-actions hero-anim" style="--d: 5">
        <a href="#productos" class="btn btn-primary">Ver productos</a>
        <a href="#contacto" class="btn btn-ghost">Contáctanos</a>
      </div>
    </div>

    <div class="hero-media">
      <div class="hero-frame">
        <Picture
          src={lechuga}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1280, 1620]}
          sizes="(max-width: 900px) 100vw, 50vw"
          alt="Surcos de lechugas verdes y moradas en una chacra del Valle de Lurín"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-badge" aria-hidden="true">
        <span class="hero-badge-dot"></span>
        Cosecha fresca del Valle de Lurín
      </div>
    </div>
  </div>
</section>
