---
import { Image } from 'astro:assets';
import i1 from '../assets/images/iconos/i1.svg';
import i2 from '../assets/images/iconos/i2.svg';
import i3 from '../assets/images/iconos/i3.svg';

const items = [
  {
    icono: i1,
    titulo: 'Atención 24/7',
    texto:
      'Nuestros clientes son lo más importante para nosotros, por eso estamos disponibles las 24 horas del día, los 7 días de la semana.',
  },
  {
    icono: i2,
    titulo: 'Precios Justos',
    texto:
      'Nuestros precios son justos, ya que no hay intermediarios entre el productor y el consumidor.',
  },
  {
    icono: i3,
    titulo: 'Envío Rápido',
    texto:
      'Nuestros envíos son rápidos y seguros, ya que contamos con un equipo de logística altamente capacitado.',
  },
];
---

<section class="information container">
  <div class="information-content">
    {
      items.map((item) => (
        <div class="information-1">
          <Image src={item.icono} alt="" />
          <h3>{item.titulo}</h3>
          <p>{item.texto}</p>
        </div>
      ))
    }
  </div>
</section>
