---
import { Picture } from 'astro:assets';
import f1 from '../assets/images/ofertas/f1.png';
import f2 from '../assets/images/ofertas/f2.png';
import f3 from '../assets/images/ofertas/f3.png';
import f4 from '../assets/images/ofertas/f4.png';

const ofertas = [f1, f2, f3, f4];
---

<section class="oferts container">
  {
    ofertas.map((imagen) => (
      <div class="ofert-1">
        <Picture
          src={imagen}
          formats={['avif', 'webp']}
          widths={[140, 280]}
          sizes="140px"
          alt=""
        />
        <h3>Oferta</h3>
        <p>Premium</p>
      </div>
    ))
  }
</section>
