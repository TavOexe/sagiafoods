---
import { Picture } from 'astro:assets';
import pr1 from '../assets/images/productos/pr1.png';
import pr2 from '../assets/images/productos/pr2.png';
import pr3 from '../assets/images/productos/pr3.png';
import pr4 from '../assets/images/productos/pr4.png';

// pr5–pr8 también están en src/assets/images/productos/ (sin usar, igual que en el original).
const productos = [
  { id: '1', imagen: pr1, nombre: 'Producto', precio: 'S/. 15.00' },
  { id: '2', imagen: pr2, nombre: 'Producto', precio: 'S/. 15.00' },
  { id: '3', imagen: pr3, nombre: 'Producto', precio: 'S/. 15.00' },
  { id: '4', imagen: pr4, nombre: 'Producto', precio: 'S/. 15.00' },
];
---

<main class="products container" id="lista-1">
  <h2>Productos destacados</h2>
  <div class="product-content">
    {
      productos.map((p) => (
        <div class="product">
          <Picture
            src={p.imagen}
            formats={['avif', 'webp']}
            widths={[200, 400, 500]}
            sizes="(max-width: 700px) 90vw, 200px"
            alt={p.nombre}
          />
          <div class="product-txt">
            <h3>{p.nombre}</h3>
            <p class="precio">{p.precio}</p>
            <a href="#" class="agregar-carrito btn-2" data-id={p.id}>
              Agregar
            </a>
          </div>
        </div>
      ))
    }
  </div>
</main>
