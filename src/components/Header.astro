---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';

const enlaces = [
  { href: '#productos', texto: 'Productos' },
  { href: '#proceso', texto: 'Proceso' },
  { href: '#origen', texto: 'Origen' },
];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="#inicio" class="brand" aria-label="SagiaFoods Perú, ir al inicio">
      <Image src={logo} alt="SagiaFoods" width={124} loading="eager" />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-principal"
      data-menu-toggle
    >
      <span class="sr-only">Abrir menú</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>

    <nav id="nav-principal" class="site-nav" aria-label="Principal" data-nav>
      <ul>
        {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
      </ul>
      <a href="#contacto" class="btn btn-primary btn-sm">Contáctanos</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  function cerrar() {
    header?.classList.remove('menu-abierto');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', () => {
    const abierto = header?.classList.toggle('menu-abierto') ?? false;
    toggle.setAttribute('aria-expanded', String(abierto));
  });
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) cerrar();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrar();
  });

  // Sombra suave en la cabecera al hacer scroll.
  const marcar = () => header?.classList.toggle('con-scroll', window.scrollY > 8);
  marcar();
  window.addEventListener('scroll', marcar, { passive: true });
</script>
