---
import { Picture } from 'astro:assets';
import Carrito from './Carrito.astro';
import logo from '../assets/images/logo-header.png';

const enlaces = ['Inicio', 'Nosotros', 'Productos', 'Contacto', 'Webmail'];
---

<header class="header">
  <div class="menu">
    <label for="menu">
      <img
        src="https://img.icons8.com/fluent-systems-regular/2x/menu-squared-2.png"
        width="40"
        height="40"
        alt="menu"
      />
    </label>

    <div class="logo-header">
      <Picture
        src={logo}
        formats={['avif', 'webp']}
        widths={[250, 500]}
        sizes="250px"
        alt="Logo SagiaFoods Perú"
        loading="eager"
      />
      <a href="#" class="logo"> SagiaFoods Perú </a>
    </div>

    <input type="checkbox" id="menu" />
    <nav class="navbar">
      <ul>
        {enlaces.map((texto) => <li><a href="#">{texto}</a></li>)}
      </ul>
    </nav>
    <div>
      <ul>
        <Carrito />
      </ul>
    </div>
  </div>

  <!-- El contenido principal de la cabecera (Hero) entra aquí para conservar el DOM original -->
  <slot />
</header>
