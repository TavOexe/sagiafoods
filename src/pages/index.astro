---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sellos from '../components/Sellos.astro';
import Productos from '../components/Productos.astro';
import Proceso from '../components/Proceso.astro';
import Origen from '../components/Origen.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <Sellos />
    <Productos />
    <Proceso />
    <Origen />
    <Contacto />
  </main>
  <Footer />
</BaseLayout>
